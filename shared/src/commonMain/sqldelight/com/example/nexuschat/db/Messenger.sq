CREATE TABLE messenger_conversation (
    server_url TEXT NOT NULL,
    account_id TEXT NOT NULL,
    id TEXT NOT NULL,
    members_json TEXT NOT NULL,
    cursor INTEGER NOT NULL DEFAULT 0 CHECK(cursor >= 0),
    PRIMARY KEY(server_url, account_id, id)
);

CREATE TABLE messenger_message (
    server_url TEXT NOT NULL,
    account_id TEXT NOT NULL,
    conversation_id TEXT NOT NULL,
    id TEXT NOT NULL,
    sender_id TEXT NOT NULL,
    sequence INTEGER NOT NULL CHECK(sequence > 0),
    idempotency_key TEXT NOT NULL,
    body TEXT NOT NULL,
    PRIMARY KEY(server_url, account_id, conversation_id, id),
    UNIQUE(server_url, account_id, conversation_id, sequence),
    FOREIGN KEY(server_url, account_id, conversation_id)
        REFERENCES messenger_conversation(server_url, account_id, id) ON DELETE CASCADE
);

CREATE TABLE messenger_outbox (
    server_url TEXT NOT NULL,
    account_id TEXT NOT NULL,
    conversation_id TEXT NOT NULL,
    idempotency_key TEXT NOT NULL,
    body TEXT NOT NULL,
    state TEXT NOT NULL CHECK(state IN ('PENDING', 'SENDING', 'FAILED')),
    PRIMARY KEY(server_url, account_id, idempotency_key),
    FOREIGN KEY(server_url, account_id, conversation_id)
        REFERENCES messenger_conversation(server_url, account_id, id) ON DELETE CASCADE
);

selectConversations:
SELECT * FROM messenger_conversation WHERE server_url = ? AND account_id = ? ORDER BY id;

insertConversation:
INSERT OR IGNORE INTO messenger_conversation(server_url, account_id, id, members_json)
VALUES (?, ?, ?, ?);

updateMembers:
UPDATE messenger_conversation SET members_json = ?
WHERE server_url = ? AND account_id = ? AND id = ?;

selectMessages:
SELECT * FROM messenger_message
WHERE server_url = ? AND account_id = ? AND conversation_id = ? ORDER BY sequence;

messageAtSequence:
SELECT * FROM messenger_message WHERE server_url = ? AND account_id = ? AND conversation_id = ? AND sequence = ?;

pendingByKey:
SELECT * FROM messenger_outbox WHERE server_url = ? AND account_id = ? AND idempotency_key = ?;

insertMessage:
INSERT OR IGNORE INTO messenger_message(server_url, account_id, conversation_id, id, sender_id, sequence, idempotency_key, body)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

advanceCursor:
UPDATE messenger_conversation SET cursor = MAX(cursor, ?)
WHERE server_url = ? AND account_id = ? AND id = ?;

selectOutbox:
SELECT * FROM messenger_outbox WHERE server_url = ? AND account_id = ? ORDER BY rowid;

insertPending:
INSERT INTO messenger_outbox(server_url, account_id, conversation_id, idempotency_key, body, state)
VALUES (?, ?, ?, ?, ?, ?);

pendingState:
UPDATE messenger_outbox SET state = ? WHERE server_url = ? AND account_id = ? AND idempotency_key = ?;

recoverPending:
UPDATE messenger_outbox SET state = 'PENDING'
WHERE server_url = ? AND account_id = ? AND state = 'SENDING';

deletePending:
DELETE FROM messenger_outbox WHERE server_url = ? AND account_id = ? AND idempotency_key = ?;
